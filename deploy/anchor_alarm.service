[Unit]
Description=SignalK notification alarm daemon (anchor drag, etc.) - Conachair
After=signalk.service network-online.target
Wants=network-online.target

[Service]
Type=simple
# Type=notify once python-systemd is added so sd_notify is no longer a no-op.
User=pi
WorkingDirectory=/home/pi/pi-deck-tools
ExecStart=/home/pi/pi-deck-tools/.venv/bin/python3 apps/anchor_alarm.py
Environment=PYTHONUNBUFFERED=1
Environment=XDG_RUNTIME_DIR=/run/user/1000
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
