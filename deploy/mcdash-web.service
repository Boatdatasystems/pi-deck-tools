[Unit]
Description=Mission Control web dashboard (read-only Flask view on :8765) - Conachair
After=network-online.target mcd.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/pi-deck-tools
ExecStart=/home/pi/pi-deck-tools/.venv/bin/python3 apps/mcdash_web.py
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
